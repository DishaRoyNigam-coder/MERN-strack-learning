{
  "name": "posts-api",
  "version": "1.0.0",
  "description": "A simple REST API for blog posts (in-memory)",
  "type": "module",
  "main": "server.js",
 "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test:api": "newman run tests/Posts-API.postman_collection.json -e tests/Development.postman_environment.json",
    "test:api:report": "newman run tests/Posts-API.postman_collection.json -e tests/Development.postman_environment.json --reporters cli,htmlextra --reporter-htmlextra-export tests/report.html"
  },
  "keywords": ["express", "rest", "api", "crud", "posts"],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "newman": "^6.0.0"
  }
}