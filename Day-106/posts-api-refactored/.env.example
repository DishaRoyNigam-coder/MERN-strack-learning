NODE_ENV=development
PORT=3000
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRES_IN=7d
JWT_ISSUER=posts-api
JWT_AUDIENCE=posts-api-users
BCRYPT_ROUNDS=10hphle 
COOKIE_SECRET=change-me-to-a-random-string
COOKIE_NAME=auth_token
COOKIE_MAX_AGE=604800000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif
EMAIL_SERVICE=nodemailer
EMAIL_FROM="Posts API <noreply@posts-api.com>"
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=RATE_LIMIT_DISABLED=false
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_REGISTER_MAX=3
RATE_LIMIT_REGISTER_WINDOW_MS=3600000
RATE_LIMIT_PASSWORD_RESET_MAX=3
RATE_LIMIT_PASSWORD_RESET_WINDOW_MS=3600000
RATE_LIMIT_GENERAL_MAX=100
RATE_LIMIT_GENERAL_WINDOW_MS=60000
RATE_LIMIT_UPLOAD_MAX=10
RATE_LIMIT_UPLOAD_WINDOW_MS=3600000

LOG_LEVEL=debug
LOG_DIR=logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d
LOG_TO_FILE=true
LOG_TO_CONSOLE=true
LOG_PRETTY=true


SECURITY_HSTS_ENABLED=false
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_CSP_REPORT_ONLY=false
SECURITY_FRAME_OPTIONS=DENY
SECURITY_REFERRER_POLICY=no-referrer